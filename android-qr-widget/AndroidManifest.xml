<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.mdcz.qrpaywidget"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="23" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true">

        <receiver
            android:name=".QRPaymentWidget"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <activity
            android:name=".EnterAmountActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".ShowQRActivity"
            android:label="@string/payment_qr"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WidgetConfigActivity"
            android:label="@string/config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name=".QRFileProvider"
            android:authorities="net.mdcz.qrpaywidget.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
